<script language="vbscript" runat="server">







Sub Application_OnStart
	application("limite_actualidad")=150
	application("limite_estudios")=60
	application("limite_subastas")=30
	application("limite_demandas")=30
	
	application("limite_deals_inv")=30
	application("limite_deals_alq")=50
	application("limite_vencimientos")=50
	
End Sub

Sub Application_OnEnd
	
End Sub

sub Session_OnStart
	
	set session("pw_ws") = Server.CreateObject("PW_WS.PW_Cliente")
	
	session("pw_ws").SessionId = session.SessionID
	session("pw_ws").Host = request.ServerVariables("HTTP_HOST")
	session("pw_ws").IP = request.ServerVariables("REMOTE_ADDR")
	session("pw_ws").UserAgent = request.ServerVariables("HTTP_USER_AGENT")
	session("pw_ws").AllHttp = request.ServerVariables("ALL_HTTP")
	session("pw_ws").Cookies = request.Cookies
	
	session("IniCliente") = session("pw_ws").IniCliente(request.Cookies("licencia")("n"), request.Cookies("licencia")("u"), request.Cookies("licencia")("p"), request.Cookies("licencia")("user_id"), request.Cookies("licencia")("movil"))
	
	'session("connPW")
	set session("connPW") = Server.CreateObject("ADODB.Connection")
	session("connPW").Open session("pw_ws").cnxPW
	
	'session("connPWAcesos")
	set session("connPWAcesos") = Server.CreateObject("ADODB.Connection")
	session("connPWAcesos").Open session("pw_ws").cnxAccesos
	
	'variables	
	session("PalabrasClave")
	
	session("reg_pags")
	session("articulos") = "#"
	session("bloqueos") = "#"
	
	'session("http_mozilla") = session("pw_ws").Mozilla
	'session("http_ip") = request.ServerVariables("REMOTE_ADDR")
	'session("http_so")= session("pw_ws").SO
	'session("http_navegador") = session("pw_ws").Navegador
	
	session("touch") = false
	
	'Movil	

	u = str
	set b = new RegExp
	set v = new RegExp
	b.Pattern="(android|bb\d+|meego).+mobile|avantgo|bada\/|blackberry|blazer|compal|elaine|fennec|hiptop|iemobile|ip(hone|od)|iris|kindle|lge |maemo|midp|mmp|mobile.+firefox|netfront|opera m(ob|in)i|palm( os)?|phone|p(ixi|re)\/|plucker|pocket|psp|series(4|6)0|symbian|treo|up\.(browser|link)|vodafone|wap|windows ce|xda|xiino"
	v.Pattern="1207|6310|6590|3gso|4thp|50[1-6]i|770s|802s|a wa|abac|ac(er|oo|s\-)|ai(ko|rn)|al(av|ca|co)|amoi|an(ex|ny|yw)|aptu|ar(ch|go)|as(te|us)|attw|au(di|\-m|r |s )|avan|be(ck|ll|nq)|bi(lb|rd)|bl(ac|az)|br(e|v)w|bumb|bw\-(n|u)|c55\/|capi|ccwa|cdm\-|cell|chtm|cldc|cmd\-|co(mp|nd)|craw|da(it|ll|ng)|dbte|dc\-s|devi|dica|dmob|do(c|p)o|ds(12|\-d)|el(49|ai)|em(l2|ul)|er(ic|k0)|esl8|ez([4-7]0|os|wa|ze)|fetc|fly(\-|_)|g1 u|g560|gene|gf\-5|g\-mo|go(\.w|od)|gr(ad|un)|haie|hcit|hd\-(m|p|t)|hei\-|hi(pt|ta)|hp( i|ip)|hs\-c|ht(c(\-| |_|a|g|p|s|t)|tp)|hu(aw|tc)|i\-(20|go|ma)|i230|iac( |\-|\/)|ibro|idea|ig01|ikom|im1k|inno|ipaq|iris|ja(t|v)a|jbro|jemu|jigs|kddi|keji|kgt( |\/)|klon|kpt |kwc\-|kyo(c|k)|le(no|xi)|lg( g|\/(k|l|u)|50|54|\-[a-w])|libw|lynx|m1\-w|m3ga|m50\/|ma(te|ui|xo)|mc(01|21|ca)|m\-cr|me(rc|ri)|mi(o8|oa|ts)|mmef|mo(01|02|bi|de|do|t(\-| |o|v)|zz)|mt(50|p1|v )|mwbp|mywa|n10[0-2]|n20[2-3]|n30(0|2)|n50(0|2|5)|n7(0(0|1)|10)|ne((c|m)\-|on|tf|wf|wg|wt)|nok(6|i)|nzph|o2im|op(ti|wv)|oran|owg1|p800|pan(a|d|t)|pdxg|pg(13|\-([1-8]|c))|phil|pire|pl(ay|uc)|pn\-2|po(ck|rt|se)|prox|psio|pt\-g|qa\-a|qc(07|12|21|32|60|\-[2-7]|i\-)|qtek|r380|r600|raks|rim9|ro(ve|zo)|s55\/|sa(ge|ma|mm|ms|ny|va)|sc(01|h\-|oo|p\-)|sdk\/|se(c(\-|0|1)|47|mc|nd|ri)|sgh\-|shar|sie(\-|m)|sk\-0|sl(45|id)|sm(al|ar|b3|it|t5)|so(ft|ny)|sp(01|h\-|v\-|v )|sy(01|mb)|t2(18|50)|t6(00|10|18)|ta(gt|lk)|tcl\-|tdg\-|tel(i|m)|tim\-|t\-mo|to(pl|sh)|ts(70|m\-|m3|m5)|tx\-9|up(\.b|g1|si)|utst|v400|v750|veri|vi(rg|te)|vk(40|5[0-3]|\-v)|vm40|voda|vulc|vx(52|53|60|61|70|80|81|83|85|98)|w3c(\-| )|webc|whit|wi(g |nc|nw)|wmlb|wonu|x700|yas\-|your|zeto|zte\-"
	b.IgnoreCase=true
	v.IgnoreCase=true
	b.Global=true
	v.Global=true
	es_movil = false
	if b.test(u) or v.test(Left(u,4)) then es_movil = true
	
	session("movil") = es_movil
	
	'es_cliente	
	response.Cookies("condiciones")=""
	if request.Cookies("licencia")="" then 
		session("es_cliente")=false
		session("acceso_activo")=false
	else
		session("es_cliente")=true
		if session("IniCliente")=0 then
			session("acceso_activo")=true
			response.Cookies("condiciones")="true"
			'session("PW_WS").boolAceptadasCondiciones = true
		else
			session("acceso_activo")=false
		end if
	end if
	
	'Old Browsers
	'session("navegador")="old"

	'Modo	
	session("modo") = ""
	if request.Cookies("config")("modo")<>"" then
		session("modo") = request.Cookies("config")("modo")
		response.cookies("modo") = session("modo")
	end if
	
	session("leer_modal") = false
	select case session("modo")
	case "old", "jm", "daniel", "foldy"
		session("leer_modal") = true
	case "dev"
		if request.Cookies("config")("css")="foldy" then 
			session("leer_modal") = true
		else
			session("leer_modal") = false
		end if
	end select
	
	if request.Cookies("config")("leer")<>"" then
		session("leer_modal") = true
	end if
	
	session("touch") = false
	
	'Registro de Accesos	
	str = lcase(request.ServerVariables("HTTP_USER_AGENT"))

'Mozilla	
	if instr(str, "mozilla/5.0")>0 then
		http_mozilla = "Mozilla/5.0"
	elseif instr(str, "mozilla/4.0")>0 then
		http_mozilla = "Mozilla/4.0"
	else
		http_mozilla = ""
	end if
	session("http_mozilla") = http_mozilla
	'old	
	if http_mozilla="Mozilla/4.0" then
		session("navegador")="old"
	end if
	
'Movil
	dim b, v
	u = str
	set b = new RegExp
	set v = new RegExp
	b.Pattern="(android|bb\d+|meego).+mobile|avantgo|bada\/|blackberry|blazer|compal|elaine|fennec|hiptop|iemobile|ip(hone|od)|iris|kindle|lge |maemo|midp|mmp|mobile.+firefox|netfront|opera m(ob|in)i|palm( os)?|phone|p(ixi|re)\/|plucker|pocket|psp|series(4|6)0|symbian|treo|up\.(browser|link)|vodafone|wap|windows ce|xda|xiino"
	v.Pattern="1207|6310|6590|3gso|4thp|50[1-6]i|770s|802s|a wa|abac|ac(er|oo|s\-)|ai(ko|rn)|al(av|ca|co)|amoi|an(ex|ny|yw)|aptu|ar(ch|go)|as(te|us)|attw|au(di|\-m|r |s )|avan|be(ck|ll|nq)|bi(lb|rd)|bl(ac|az)|br(e|v)w|bumb|bw\-(n|u)|c55\/|capi|ccwa|cdm\-|cell|chtm|cldc|cmd\-|co(mp|nd)|craw|da(it|ll|ng)|dbte|dc\-s|devi|dica|dmob|do(c|p)o|ds(12|\-d)|el(49|ai)|em(l2|ul)|er(ic|k0)|esl8|ez([4-7]0|os|wa|ze)|fetc|fly(\-|_)|g1 u|g560|gene|gf\-5|g\-mo|go(\.w|od)|gr(ad|un)|haie|hcit|hd\-(m|p|t)|hei\-|hi(pt|ta)|hp( i|ip)|hs\-c|ht(c(\-| |_|a|g|p|s|t)|tp)|hu(aw|tc)|i\-(20|go|ma)|i230|iac( |\-|\/)|ibro|idea|ig01|ikom|im1k|inno|ipaq|iris|ja(t|v)a|jbro|jemu|jigs|kddi|keji|kgt( |\/)|klon|kpt |kwc\-|kyo(c|k)|le(no|xi)|lg( g|\/(k|l|u)|50|54|\-[a-w])|libw|lynx|m1\-w|m3ga|m50\/|ma(te|ui|xo)|mc(01|21|ca)|m\-cr|me(rc|ri)|mi(o8|oa|ts)|mmef|mo(01|02|bi|de|do|t(\-| |o|v)|zz)|mt(50|p1|v )|mwbp|mywa|n10[0-2]|n20[2-3]|n30(0|2)|n50(0|2|5)|n7(0(0|1)|10)|ne((c|m)\-|on|tf|wf|wg|wt)|nok(6|i)|nzph|o2im|op(ti|wv)|oran|owg1|p800|pan(a|d|t)|pdxg|pg(13|\-([1-8]|c))|phil|pire|pl(ay|uc)|pn\-2|po(ck|rt|se)|prox|psio|pt\-g|qa\-a|qc(07|12|21|32|60|\-[2-7]|i\-)|qtek|r380|r600|raks|rim9|ro(ve|zo)|s55\/|sa(ge|ma|mm|ms|ny|va)|sc(01|h\-|oo|p\-)|sdk\/|se(c(\-|0|1)|47|mc|nd|ri)|sgh\-|shar|sie(\-|m)|sk\-0|sl(45|id)|sm(al|ar|b3|it|t5)|so(ft|ny)|sp(01|h\-|v\-|v )|sy(01|mb)|t2(18|50)|t6(00|10|18)|ta(gt|lk)|tcl\-|tdg\-|tel(i|m)|tim\-|t\-mo|to(pl|sh)|ts(70|m\-|m3|m5)|tx\-9|up(\.b|g1|si)|utst|v400|v750|veri|vi(rg|te)|vk(40|5[0-3]|\-v)|vm40|voda|vulc|vx(52|53|60|61|70|80|81|83|85|98)|w3c(\-| )|webc|whit|wi(g |nc|nw)|wmlb|wonu|x700|yas\-|your|zeto|zte\-"
	b.IgnoreCase=true
	v.IgnoreCase=true
	b.Global=true
	v.Global=true
	es_movil = false
	if b.test(u) or v.test(Left(u,4)) then es_movil = true
	
	session("movil") = es_movil
	
'S.O.		
	if instr(str, "windows nt 10.0")>0 then
		http_so = "win 10"
	elseif instr(str, "nt 6.3")>0 then
		http_so = "win 8.1"
	elseif instr(str, "windows nt 6.2")>0 then
		http_so = "win 8"
		
	elseif instr(str, "windows nt 6.1")>0 then
		http_so = "win 7"
	elseif instr(str, "windows nt 6.0")>0 then
		http_so = "win Vista"
	
	elseif instr(str, "windows nt 5.2")>0 then
		http_so = "win XP/2003"
	elseif instr(str, "windows nt 5.1")>0 then
		http_so = "win XP"
	elseif instr(str, "windows nt 5.0")>0 then
		http_so = "win 2000"
		
	'mac OS
	elseif instr(str, "macintosh")>0 and instr(str, "intel mac os x 10")>0 then
		http_so = "MacOS 10"
	
	'iPad
	elseif instr(str, "ipad")>0 and instr(str, "like mac os x")>0 then
		http_so = "iPad"
	
	'iPhone
	elseif instr(str, "iphone os 7")>0 then
		http_so = "iOS 7"
	elseif instr(str, "iphone os 8")>0 then
		http_so = "iOS 8"
		
	'Android
	elseif instr(str, "android")>0 then
		http_so = "Android"
	
	'Linux
	elseif instr(str, "linux i686")>0 then
		http_so = "Linux"
	elseif instr(str, "linux x86_64")>0 then
		http_so = "Linux"
	
	else
		http_so = ""
		
	end if
	
	'Win 64 bits
	if instr(str, "wow64")>0 or instr(str, "x64")>0 then
		http_so = http_so & " 64"
	end if
	session("http_so")= http_so
	
'Navegador	
	if instr(str, "edge")>0 then
		http_navegador = "edge"
	
	elseif instr(str, "chrome")>0 then
		http_navegador = "chrome"
	
	elseif instr(str, "opera")>0 then
		http_navegador = "opera"
	
	elseif instr(str, "rv:11.0")>0 then
		http_navegador = "ie 11"
	elseif instr(str, "msie 10.0")>0 then
		http_navegador = "ie 10"	
	elseif instr(str, "msie 9.0")>0 then
		http_navegador = "ie 9"
		session("navegador")="old"
	elseif instr(str, "msie 8.0")>0 then
		http_navegador = "ie 8"
	elseif instr(str, "msie 7.0")>0 then
		http_navegador = "ie 7"
	elseif instr(str, "msie 6.0")>0 then
		http_navegador = "ie 6"
		
	elseif instr(str, "firefox")>0 then
		http_navegador = "firefox"
	
	elseif instr(str, "safari")>0 then
		http_navegador = "safari"
		
	else
		http_navegador = ""
	end if
	session("http_navegador") = http_navegador
	
'IP			
	session("http_ip") = request.ServerVariables("REMOTE_ADDR")
	
'BD			
	if request.Cookies("dev")("reg")="" and request.Cookies("licencia")("log")="" then
		sql = "INSERT INTO reg_accesos (session_id, session_start, fecha, hora, "
		sql = sql & "session_pw, session_portal, session_lang, cookie_u, cookie_l, cookie_uid, cookie_lid, "
		sql = sql & "server_name, http_user_agent, http_ip, http_mozilla, http_navegador, http_so, "
		sql = sql & "info, licencia, cookies"
		
		sql = sql & ") VALUES ("
		sql = sql & "'" & session.SessionID & "', "
		'sql = sql & "GETDATE(), "
		sql = sql & "'" & Now & "', "
		sql = sql & "'" & Date & "', "
		sql = sql & "'" & Time & "', "
		
		sql = sql & "'es', "
		sql = sql & "'eu', "
		sql = sql & "'es', "
		
		if trim(request.Cookies("licencia")("n"))="" then
			sql = sql & "NULL, NULL, "
		else
			sql = sql & "'" & left(request.Cookies("licencia")("u"), 50) & "', "
			sql = sql & "'" & left(request.Cookies("licencia")("n"), 100) & "', "
		end if
		
		if request.Cookies("licencia")("client_id")="" or request.Cookies("licencia")("user_id")="" then
			sql = sql & "NULL, NULL, "
		else
			sql = sql & request.Cookies("licencia")("client_id") & ", "
			sql = sql & request.Cookies("licencia")("user_id") & ", "
		end if
		
		sql = sql & "'" & left(request.serverVariables("SERVER_NAME"), 50) & "', "
		sql = sql & "'" & left(request.ServerVariables("HTTP_USER_AGENT"), 250) & "', "
		
		sql = sql & "'" & left(request.ServerVariables("REMOTE_ADDR"), 15) & "', "
		
		sql = sql & "'" & left(http_mozilla, 25) & "', "
		sql = sql & "'" & left(http_navegador, 25) & "', "
		sql = sql & "'" & left(http_so, 25) & "', "
		
		txt = request.ServerVariables("ALL_HTTP")
		txt = replace(txt, "'", "''")
		sql = sql & "'" & txt & "', "
		
		sql = sql & "'" & left(request.Cookies("licencia"), 200) & "', "
		sql = sql & "'" & request.Cookies & "'"
		
		sql = sql & ")"
		session("connPWAcesos").execute sql
		
		'last session
		if request.Cookies("licencia")("user_id")<>"" then
			sql = "UPDATE clientes_licencias SET last_session = GETDATE() WHERE id=" & request.Cookies("licencia")("user_id")
			session("connPW").execute sql
		end if
	end if
	
	'session("navegador")="old"
	
end sub


sub Session_OnEnd
	if request.Cookies("dev")("reg")="" then
		sql="UPDATE reg_accesos SET session_logout=GETDATE() WHERE session_id='" & session.SessionID & "'"
		session("connPWAcesos").execute sql
	end if
end sub

</script>

